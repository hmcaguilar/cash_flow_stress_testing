			<div style='font-size:9px;display:inline-flex;align-items:center;gap:2px;padding:2px 6px;border-radius:4px;background:" & IF(VarEgrMoM <= 0,"#EAF3DE","#FCEBEB") & ";color:" & VEIco & ";font-weight:500;'>" & VEIc & VEgrFmt & " vs " & NombreMesAnt & "</div>
			</div>
			</div>
			<div style='display:grid;grid-template-columns:1fr 1fr 1fr;border-bottom:1px solid #E2E4E9;'>
			<div style='padding:12px 15px;border-right:1px solid #E2E4E9;'>
			<span style='font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:7px;background:" & B1 & ";color:" & C1 & ";border:1px solid " & E1 & ";'>R1 Eficiencia de Cobro</span>
			<div style='font-size:9px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#8090A8;margin-bottom:4px;'>Cobrado / Facturado</div>
			<div style='font-size:24px;font-weight:600;color:" & C1 & ";font-family:Consolas,monospace;line-height:1;'>" & R1Fmt & "</div>
			<div style='font-size:9px;color:#8090A8;margin-top:3px;margin-bottom:6px;'>de lo facturado ya es efectivo</div>
			<span style='font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:10px;background:" & B1 & ";color:" & C1 & ";border:1px solid " & E1 & ";'>" & N1 & "</span>
			<div style='display:flex;flex-direction:column;gap:5px;'>
			<div style='display:flex;align-items:center;gap:6px;'><span style='font-size:9px;color:#8090A8;min-width:72px;'>Facturado</span><div style='flex:1;height:3px;background:#E2E4E9;border-radius:2px;overflow:hidden;'><div style='height:100%;width:" & BarFacR1 & "%;background:#BA7517;border-radius:2px;'></div></div><span style='font-size:9px;color:#BA7517;font-family:Consolas,monospace;min-width:38px;text-align:right;'>" & FacFmt & "</span></div>
			<div style='display:flex;align-items:center;gap:6px;'><span style='font-size:9px;color:#8090A8;min-width:72px;'>Cobrado</span><div style='flex:1;height:3px;background:#E2E4E9;border-radius:2px;overflow:hidden;'><div style='height:100%;width:" & BarCobR1 & "%;background:#185FA5;border-radius:2px;'></div></div><span style='font-size:9px;color:#185FA5;font-family:Consolas,monospace;min-width:38px;text-align:right;'>" & CobFmt & "</span></div>
			</div>
			<div style='font-size:9px;color:#8090A8;margin-top:6px;'>Cartera pendiente: <span style='font-family:Consolas,monospace;color:" & BcColor & ";font-weight:600;'>" & BcSign & BcFmt & "</span></div>
			<div style='margin-top:7px;padding:6px 8px;background:#F7F8FA;border-radius:6px;border-left:2px solid " & E1 & ";'>
			<div style='font-size:8px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#8090A8;margin-bottom:3px;'>Tendencia ultimo mes</div>
			<div style='font-size:9px;color:#8090A8;'>" & NombreMes & ": <span style='font-family:Consolas,monospace;color:" & R1Tc & ";'>" & R1MFmt & "</span> vs " & NombreMesAnt & ": <span style='font-family:Consolas,monospace;'>" & R1MAntFmt & "</span> <span style='color:" & R1Tc & ";'>" & R1Ti & " " & R1TFmt & "</span></div>
			</div>
			</div>
			<div style='padding:12px 15px;border-right:1px solid #E2E4E9;'>
			<span style='font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:7px;background:" & B2 & ";color:" & C2 & ";border:1px solid " & E2 & ";'>R2 Exposicion</span>
			<div style='font-size:9px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#8090A8;margin-bottom:4px;'>Egresos / Cobrado</div>
			<div style='font-size:24px;font-weight:600;color:" & C2 & ";font-family:Consolas,monospace;line-height:1;'>" & R2Fmt & "</div>
			<div style='font-size:9px;color:#8090A8;margin-top:3px;margin-bottom:6px;'>por $1 cobrado, salio de caja</div>
			<span style='font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:10px;background:" & B2 & ";color:" & C2 & ";border:1px solid " & E2 & ";'>" & N2 & "</span>
			<div style='display:flex;flex-direction:column;gap:5px;'>
			<div style='display:flex;align-items:center;gap:6px;'><span style='font-size:9px;color:#8090A8;min-width:72px;'>Egresos</span><div style='flex:1;height:3px;background:#E2E4E9;border-radius:2px;overflow:hidden;'><div style='height:100%;width:" & BarEgrR2 & "%;background:" & C2 & ";border-radius:2px;'></div></div><span style='font-size:9px;color:" & C2 & ";font-family:Consolas,monospace;min-width:38px;text-align:right;'>" & EgrFmt & "</span></div>
			<div style='display:flex;align-items:center;gap:6px;'><span style='font-size:9px;color:#8090A8;min-width:72px;'>Cobrado</span><div style='flex:1;height:3px;background:#E2E4E9;border-radius:2px;overflow:hidden;'><div style='height:100%;width:" & BarCobR2 & "%;background:#185FA5;border-radius:2px;'></div></div><span style='font-size:9px;color:#185FA5;font-family:Consolas,monospace;min-width:38px;text-align:right;'>" & CobFmt & "</span></div>
			</div>
			<div style='font-size:9px;color:#8090A8;margin-top:6px;'>Descalce acum.: <span style='font-family:Consolas,monospace;color:" & BfColor & ";font-weight:600;'>" & BfSign & BfFmt & "</span></div>
			<div style='margin-top:7px;padding:6px 8px;background:#F7F8FA;border-radius:6px;border-left:2px solid " & E2 & ";'>
			<div style='font-size:8px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#8090A8;margin-bottom:3px;'>Tendencia ultimo mes</div>
			<div style='font-size:9px;color:#8090A8;'>" & NombreMes & ": <span style='font-family:Consolas,monospace;color:" & R2Tc & ";'>" & R2MFmt & "</span> vs " & NombreMesAnt & ": <span style='font-family:Consolas,monospace;'>" & R2MAntFmt & "</span> <span style='color:" & R2Tc & ";'>" & R2Ti & " " & R2TFmt & "</span> (bajar = mejor)</div>
			</div>
			</div>
			<div style='padding:12px 15px;'>
			<span style='font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:7px;background:" & B3 & ";color:" & C3 & ";border:1px solid " & E3 & ";'>R3 Cobertura</span>
			<div style='font-size:9px;font-weight:600;letter-spacing:.06em;text-transform:uppercase;color:#8090A8;margin-bottom:4px;'>Cobrado / Egresos</div>
			<div style='font-size:24px;font-weight:600;color:" & C3 & ";font-family:Consolas,monospace;line-height:1;'>" & R3Fmt & "</div>
			<div style='font-size:9px;color:#8090A8;margin-top:3px;margin-bottom:6px;'>de egresos con respaldo de cobro</div>
			<span style='font-size:9px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;padding:2px 8px;border-radius:4px;display:inline-block;margin-bottom:10px;background:" & B3 & ";color:" & C3 & ";border:1px solid " & E3 & ";'>" & N3 & "</span>
			<div style='display:flex;flex-direction:column;gap:5px;'>
			<div style='display:flex;align-items:center;gap:6px;'><span style='font-size:9px;color:#8090A8;min-width:72px;'>Con cobertura</span><div style='flex:1;height:3px;background:#E2E4E9;border-radius:2px;overflow:hidden;'><div style='height:100%;width:" & BarCob3 & "%;background:#185FA5;border-radius:2px;'></div></div><span style='font-size:9px;color:#185FA5;font-family:Consolas,monospace;min-width:38px;text-align:right;'>" & CobFmt & "</span></div>
			<div style='display:flex;align-items:center;gap:6px;'><span style='font-size:9px;color:#8090A8;min-width:72px;'>Sin cobertura</span><div style='flex:1;height:3px;background:#E2E4E9;border-radius:2px;overflow:hidden;'><div style='height:100%;width:" & BarSinCob & "%;background:" & C3 & ";border-radius:2px;'></div></div><span style='font-size:9px;color:" & C3 & ";font-family:Consolas,monospace;min-width:38px;text-align:right;'>" & SinCobFmt & "</span></div>
			</div>
			<div style='font-size:9px;color:#8090A8;margin-top:6px;'>Cartera pendiente: <span style='font-family:Consolas,monospace;color:" & FlotColor & ";font-weight:600;'>" & FlotFmt & " - " & PctFlotFmt & "</span></div>
			<div style='margin-top:7px;padding:6px 8px;background:#F7F8FA;border-radius:6px;border-left:2px solid " & E3 & ";'>
			<div style='font-size:8px;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:#8090A8;margin-bottom:3px;'>Tendencia ultimo mes</div>
			<div style='font-size:9px;color:#8090A8;'>" & NombreMes & ": <span style='font-family:Consolas,monospace;color:" & R3Tc & ";'>" & R3MFmt & "</span> vs " & NombreMesAnt & ": <span style='font-family:Consolas,monospace;'>" & R3MAntFmt & "</span> <span style='color:" & R3Tc & ";'>" & R3Ti & " " & R3TFmt & "</span></div>
			</div>
			</div>
			</div>
			<div style='padding:9px 20px;border-bottom:1px solid #E2E4E9;display:flex;align-items:flex-start;gap:8px;'>
			<div style='font-size:10px;color:#5C6A80;line-height:1.6;'>
			<strong style='color:" & AlertaColor & ";'>" & AlertaTitulo & "</strong>" & StoryDiv & "
			</div>
			</div>
			<div style='padding:13px 20px;display:flex;flex-direction:column;gap:9px;'>
			<div><div style='font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:" & C1 & ";margin-bottom:4px;'>R1 Eficiencia de cobro acumulada</div><div style='font-size:10px;color:#5C6A80;line-height:1.65;'>" & StoryR1 & "</div></div>
			<div style='height:1px;background:#E2E4E9;'></div>
			<div><div style='font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:" & C2 & ";margin-bottom:4px;'>R2 Exposicion de caja acumulada</div><div style='font-size:10px;color:#5C6A80;line-height:1.65;'>" & StoryR2 & "</div></div>
			<div style='height:1px;background:#E2E4E9;'></div>
			<div><div style='font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:" & C3 & ";margin-bottom:4px;'>R3 Cobertura de egresos acumulada</div><div style='font-size:10px;color:#5C6A80;line-height:1.65;'>" & StoryR3 & "</div></div>
			<div style='height:1px;background:#E2E4E9;'></div>
			<div><div style='font-size:9px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#854F0B;margin-bottom:4px;'>Cartera acumulada pendiente de cobro</div><div style='font-size:10px;color:#5C6A80;line-height:1.65;'>" & StoryFlot & "</div></div>
			</div>
			<div style='padding:8px 20px;border-top:1px solid #E2E4E9;font-size:9px;color:#A0AEC0;line-height:1.6;'>
			R1 / R2 / R3 sobre acumulado total sin filtro de fecha. Tendencia MoM basada en Fecha_Emision (facturado) y Fecha_Pago_Real (cobrado) como indicador de direccion reciente.
			</div>
			</div>"
		displayFolder: HTML Content
		lineageTag: d74db948-5cf0-4529-9e17-bcf945712b60

	/// Fecha de corte: último Fecha_Pago_Real registrado. Los flujos anteriores son reales; el estrés sólo aplica a la cartera abierta.
	measure 'Fecha Corte' =
			-- Último movimiento real registrado: todo lo anterior es flujo realizado (no se estresa)
			CALCULATE(MAX(fact_Cartera_CxC_CxP[Fecha_Pago_Real]), ALL(fact_Cartera_CxC_CxP), ALL(dim_Calendario))
		formatString: Short Date
		lineageTag: bf515158-760d-4604-9ad7-a259ed4f5410

	measure 'Estado Recomendacion' =
			-- 0 = Mantener | 1 = Aplicar pronto pago | 2 = Pronto pago no basta, usar línea | 3 = Déficit mayor a la línea
			VAR MinEst = [Minimo de Caja]
			VAR MinPP = MINX(ALLSELECTED(dim_Calendario[Date]), [Caja Acumulada con Pronto Pago])
			VAR HayDescuento = [dax_Pct_Descuento_PP] > 0
			VAR Limite = [Valor de Param_Limite_Linea_Credito]
			RETURN
			SWITCH(TRUE(),
			    MinEst >= 0, 0,
			    HayDescuento && MinPP >= 0, 1,
			    -MinEst <= Limite, 2,
			    3
			)
		formatString: 0
		isHidden
		lineageTag: 3dd95231-c371-4100-bd29-e132bcdb5948

	measure HTML_Linea_Credito =
			VAR UltimaFecha = CALCULATE(MAX(dim_Calendario[Date]), ALLSELECTED(dim_Calendario))
			VAR Disposicion = COALESCE(CALCULATE([Linea de Credito Dispuesta Acumulada], dim_Calendario[Date] = UltimaFecha), 0)
			VAR Interes = COALESCE(CALCULATE([Interes Acumulado Linea de Credito], dim_Calendario[Date] = UltimaFecha), 0)
			VAR MinConLinea = [Minimo de Caja con Linea de Credito]
			VAR Deficit = MAX(0, -[Minimo de Caja])
			VAR Limite = [Valor de Param_Limite_Linea_Credito]
			VAR ColorMin = IF(MinConLinea < 0, "#FF5D5D", "#A78BFA")
			VAR Nota =
			    SWITCH(TRUE(),
			        Deficit = 0, "La caja no cae bajo cero en este escenario: la línea no se dispone y no genera costo financiero.",
			        Deficit > Limite, "⚠️ El límite actual <b style=""color:#8C97AF"">no alcanza a cubrir</b> el peor déficit proyectado (" & FORMAT(Deficit, "$#,##0") & ") — considera un límite mayor o combinarlo con pronto pago.",
			        "La línea se dispone únicamente hasta cubrir el peor déficit acumulado alcanzado a la fecha, sin exceder el límite — y acumula interés sobre el saldo dispuesto."
			    )
			VAR Card = "background:#0D1526;border:1px solid rgba(255,255,255,.05);border-radius:10px;padding:16px 16px 14px;"
			VAR Lbl = "font-family:'JetBrains Mono',monospace;font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#565F76;margin-bottom:10px;"
			VAR Val = "font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:600;letter-spacing:-.01em;"
			RETURN
			"<div style=""font-family:Inter,sans-serif;background:#111B30;border:1px solid rgba(255,255,255,.08);border-radius:14px;padding:26px 26px 20px;"">" &
			"<div style=""display:flex;justify-content:space-between;align-items:baseline;margin-bottom:20px;flex-wrap:wrap;gap:8px;"">" &
			"<div style=""font-family:Fraunces,serif;font-weight:600;font-size:19px;color:#EAEEF7;"">Línea de Crédito de Respaldo</div>" &
			"<div style=""font-family:'JetBrains Mono',monospace;font-size:11px;color:#565F76;"">Aquí está la solución, no solo el problema</div>" &
			"</div>" &
			"<div style=""display:grid;grid-template-columns:repeat(3,1fr);gap:12px;"">" &
			"<div style=""" & Card & """><div style=""" & Lbl & """>Disposición Máxima</div><div style=""" & Val & "color:#EAEEF7;"">" & FORMAT(Disposicion, "$#,##0") & "</div></div>" &
			"<div style=""" & Card & """><div style=""" & Lbl & """>Costo Financiero</div><div style=""" & Val & "color:#EAEEF7;"">" & FORMAT(Interes, "$#,##0") & "</div></div>" &
			"<div style=""" & Card & """><div style=""" & Lbl & """>Mínimo con Línea</div><div style=""" & Val & "color:" & ColorMin & ";"">" & FORMAT(MinConLinea, "$#,##0") & "</div></div>" &
			"</div>" &
			"<div style=""font-size:12.5px;color:#565F76;line-height:1.7;margin-top:18px;padding-top:14px;border-top:1px solid rgba(255,255,255,.05);"">" & Nota & "</div>" &
			"</div>"
		displayFolder: HTML Content
		lineageTag: 1c25048e-18d6-44e0-9901-714a6838ef5c

	partition Medidas = m
		mode: import
		source =
				let
				  Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [#"Columna 1" = _t]),
				    #"Columnas quitadas" = Table.RemoveColumns(Origen,{"Columna 1"})
				in
				  #"Columnas quitadas"

	annotation PBI_NavigationStepName = Navegación

	annotation PBI_ResultType = Table

